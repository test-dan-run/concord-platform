# Copy to .env (gitignored). `just` loads it automatically.

# Hugging Face token, only for `hf download` / `just fetch-weights` of gated repos. Services never
# download anything at start.
HF_TOKEN=

# Where weights live on this machine. Engine services mount ${AI_ASSETS} read-only at /models (each
# model is a local copy, /models/<dir>); custom services mount ${AI_ASSETS}/custom-models/<name>/<version>.
AI_ASSETS=~/ai-assets

# Host used by the aicore client. localhost -> published host ports.
# Inside a container on ai-net use AI_HOST={name}: {name} becomes the service name and the
# internal port is used (e.g. http://qwen3-8b:8000).
AI_HOST=localhost
