  color-scheme: light dark;
  --bg: #f6f7f9; --surface: #ffffff; --surface-2: #f0f2f5; --border: #dde1e7;
  --text: #1b1f24; --muted: #5d6673; --accent: #2f6fec;
  --up: #1f9d55; --down: #c43d3d; --unknown: #9aa3ad;
  --limit: #1b1f24;
  --b-model-bg: #e3edff; --b-model-fg: #1d4fb8;
  --b-utility-bg: #ddf4ee; --b-utility-fg: #106b55;
  --b-openai-bg: #e2f5e5; --b-openai-fg: #19692c;
  --b-oip-bg: #efe6ff; --b-oip-fg: #5b2db3;
  --b-inspired-bg: #fff1d6; --b-inspired-fg: #8a5a00;
  --b-neutral-bg: #eceff3; --b-neutral-fg: #3b4350;
  --seg-1: #4f7fe8; --seg-2: #2fa58a; --seg-3: #d08a1e; --seg-4: #a25ad6; --seg-5: #d2556b; --seg-6: #5aa5d6;
  --code-bg: #f3f5f8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111418; --surface: #191d23; --surface-2: #20252d; --border: #2d333c;
    --text: #e6e9ee; --muted: #9aa4b2; --accent: #6d9cff;
    --up: #3fcf7f; --down: #ef6b6b; --unknown: #6b7480;
    --limit: #e6e9ee;
    --b-model-bg: #1d2c4d; --b-model-fg: #9dbcff;
    --b-utility-bg: #143a33; --b-utility-fg: #7fdcc3;
    --b-openai-bg: #173a22; --b-openai-fg: #8be3a2;
    --b-oip-bg: #2f2350; --b-oip-fg: #c9b1ff;
    --b-inspired-bg: #3d2e10; --b-inspired-fg: #f2c46b;
    --b-neutral-bg: #262c35; --b-neutral-fg: #c2cad6;
    --seg-1: #6d9cff; --seg-2: #45c7a8; --seg-3: #e9a443; --seg-4: #bf86ef; --seg-5: #ee7a8e; --seg-6: #79c0ec;
    --code-bg: #12161b;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
code, pre, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; }
.wrap { max-width: 1280px; margin: 0 auto; padding: 20px 16px 48px; }
header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
h1 { font-size: 20px; margin: 0; }
.sub { color: var(--muted); }
.panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }

/* VRAM bars, one per GPU service */
.vram { display: grid; gap: 8px; margin-bottom: 12px; }
.vrow { display: grid; grid-template-columns: minmax(120px, 220px) 1fr auto; gap: 12px; align-items: center; }
.vrow-name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar { position: relative; height: 18px; background: var(--surface-2); border-radius: 5px; overflow: visible; display: flex; }
.bar .seg { height: 100%; border-right: 1px solid var(--surface); }
.bar .seg:first-child { border-radius: 5px 0 0 5px; }
.bar .limit { position: absolute; top: -4px; bottom: -4px; width: 2px; background: var(--limit); opacity: .7; }
.vrow-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.legend { color: var(--muted); font-size: 12px; }

/* filters */
.filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 16px 0; }
.filters input, .filters select {
  background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 7px;
  padding: 6px 9px; font: inherit;
}
.filters input[type=search] { flex: 1 1 220px; min-width: 0; }
.count { color: var(--muted); margin-left: auto; }

/* cards */
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 14px; }
@media (max-width: 440px) { .grid { grid-template-columns: 1fr; } .prof { grid-template-columns: 1fr; } .prof-cpu { grid-column: 1; } }
.card { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.card-top { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.card-top h2 { font-size: 16px; margin: 0; }
.dot { width: 10px; height: 10px; border-radius: 50%; background: var(--unknown); flex: none; }
.dot.up { background: var(--up); box-shadow: 0 0 0 3px color-mix(in srgb, var(--up) 25%, transparent); }
.dot.down { background: var(--down); }
.alias { color: var(--muted); }
.badges { display: flex; flex-wrap: wrap; gap: 6px; }
.badge { border-radius: 999px; padding: 1px 9px; font-size: 12px; font-weight: 600; background: var(--b-neutral-bg); color: var(--b-neutral-fg); white-space: nowrap; }
.badge.model { background: var(--b-model-bg); color: var(--b-model-fg); }
.badge.utility { background: var(--b-utility-bg); color: var(--b-utility-fg); }
.badge.openai { background: var(--b-openai-bg); color: var(--b-openai-fg); }
.badge.oip-v2 { background: var(--b-oip-bg); color: var(--b-oip-fg); }
.badge.openai-inspired { background: var(--b-inspired-bg); color: var(--b-inspired-fg); }
.tags { display: flex; flex-wrap: wrap; gap: 5px; }
.tag { border: 1px solid var(--border); border-radius: 6px; padding: 0 7px; font-size: 12px; color: var(--muted); white-space: nowrap; cursor: pointer; background: none; font-family: inherit; }
.tag:hover, .tag.on { color: var(--accent); border-color: var(--accent); }
.desc { margin: 0; }
.kv { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.reason { font-size: 12.5px; color: var(--muted); border-left: 3px solid var(--border); padding-left: 8px; margin: 0; }
.reason b { color: var(--text); font-weight: 600; }
table.sig { border-collapse: collapse; width: 100%; font-size: 12.5px; }
table.sig th, table.sig td { text-align: left; padding: 3px 6px; border-bottom: 1px solid var(--border); }
table.sig th { color: var(--muted); font-weight: 600; }
.codebox { position: relative; }
.codebox pre { margin: 0; background: var(--code-bg); border: 1px solid var(--border); border-radius: 7px; padding: 9px 10px; overflow-x: auto; }
.copy {
  font: inherit; font-size: 11.5px; color: var(--muted); background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; padding: 1px 7px; cursor: pointer;
}
.codebox .copy { position: absolute; top: 6px; right: 6px; }
.copy:hover { color: var(--text); border-color: var(--accent); }
.inline { display: flex; align-items: center; gap: 6px; min-width: 0; }
.inline code { overflow-wrap: anywhere; }
details summary { cursor: pointer; color: var(--muted); font-size: 12.5px; }
.empty { color: var(--muted); padding: 24px; text-align: center; }
footer { margin-top: 24px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>AI service list</h1>
    <span class="sub" id="summary"></span>
  </header>

  <section class="panel" aria-label="VRAM by service">
    <div class="vram" id="vram"></div>
    <div class="legend" id="legend"></div>
  </section>

  <div class="filters" role="search">
    <input type="search" id="q" placeholder="Search name, alias, model, task, description…" aria-label="Search">
    <select id="f-kind" aria-label="Kind"></select>
    <select id="f-contract" aria-label="Contract"></select>
    <select id="f-api" aria-label="API type"></select>
    <select id="f-task" aria-label="Task"></select>
    <select id="f-engine" aria-label="Engine"></select>
    <span class="count" id="count"></span>
  </div>

  <main class="grid" id="cards"></main>
  <footer>Status dots ping <code>/health</code> every 5 s (no-cors: reachable = up). Generated from <code>services/*.yaml</code> by <code>just render</code>.</footer>
</div>

<script id="catalog-data" type="application/json">{{ data_json }}</script>
<script>
(() => {
  "use strict";
  const DATA = JSON.parse(document.getElementById("catalog-data").textContent);
  const $ = (sel) => document.querySelector(sel);
  const el = (tag, attrs = {}, ...kids) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (v == null || v === false) continue;
      if (k === "class") n.className = v; else if (k === "text") n.textContent = v; else n.setAttribute(k, v);
    }
    for (const k of kids.flat()) if (k != null) n.append(k instanceof Node ? k : document.createTextNode(String(k)));
    return n;
  };
  const fmtGB = (x) => (Math.round(x * 10) / 10).toFixed(1) + " GB";

  async function copyText(text, btn) {
    try { await navigator.clipboard.writeText(text); }
    catch {
      const ta = el("textarea"); ta.value = text; document.body.append(ta); ta.select();
      try { document.execCommand("copy"); } finally { ta.remove(); }
    }
    const old = btn.textContent; btn.textContent = "copied"; setTimeout(() => (btn.textContent = old), 1200);
  }
  const copyBtn = (text, label = "copy") => {
    const b = el("button", { class: "copy", type: "button", title: "Copy to clipboard", text: label });
    b.addEventListener("click", () => copyText(text, b));
    return b;
  };

  // ---------------------------------------------------------------- VRAM bars
  const segColors = ["--seg-1", "--seg-2", "--seg-3", "--seg-4", "--seg-5", "--seg-6"];
  const vramEl = $("#vram");
  DATA.gpu.forEach((g, i) => {
    const bar = el("div", { class: "bar", role: "img", "aria-label": `${g.name}: ${fmtGB(g.gb)} of ${DATA.gpu_total_gb} GB` });
    const seg = el("div", { class: "seg", title: `${g.name}: ${fmtGB(g.gb)} (${g.fraction.toFixed(3)})` });
    seg.style.width = (Math.min(g.fraction, 1) * 100) + "%";
    seg.style.background = `var(${segColors[i % segColors.length]})`;
    const limit = el("div", { class: "limit", title: `util_limit ${DATA.util_limit}` });
    limit.style.left = `calc(${DATA.util_limit * 100}% - 1px)`;
    bar.append(seg, limit);
    vramEl.append(el("div", { class: "vrow" },
      el("div", { class: "vrow-name", title: g.name, text: g.name }), bar,
      el("div", { class: "vrow-num", text: `${fmtGB(g.gb)} · ${g.fraction.toFixed(3)}` })));
  });
  const cpuCount = DATA.services.length - DATA.gpu.length;
  $("#legend").textContent = `Bar = ${DATA.gpu_total_gb} GB; the marker is util_limit ${DATA.util_limit}. ` +
    `Only one GPU service runs at a time: it gets the GPU memory free at its start less 1 GiB, up to the limit, and CPU ` +
    `services run next to it (check a set with \`just vram NAME...\`). ` +
    `${cpuCount} more services run on CPU.`;

  // ---------------------------------------------------------------- filters
  const uniq = (xs) => [...new Set(xs)].sort();
  const filters = {
    kind: ["#f-kind", "All kinds", uniq(DATA.services.map((s) => s.kind))],
    contract: ["#f-contract", "All contracts", uniq(DATA.services.map((s) => s.contract))],
    api: ["#f-api", "All API types", uniq(DATA.services.map((s) => s.api))],
    task: ["#f-task", "All tasks", uniq(DATA.services.flatMap((s) => s.tasks))],
    engine: ["#f-engine", "All engines", uniq(DATA.services.map((s) => s.engine))],
  };
  for (const [, [sel, label, values]] of Object.entries(filters)) {
    const s = $(sel);
    s.append(el("option", { value: "", text: label }), ...values.map((v) => el("option", { value: v, text: v })));
    s.addEventListener("change", apply);
  }
  $("#q").addEventListener("input", apply);

  // ---------------------------------------------------------------- cards
  const cards = [];
  const dots = [];
  for (const s of DATA.services) {
    const dot = el("span", { class: "dot", title: "status unknown", role: "status", "aria-label": "status unknown" });
    dots.push([s, dot]);

    const engineBadge = s.engine === "custom"
      ? el("span", { class: "badge", title: s.image, text: "custom" })
      : el("span", { class: "badge", title: s.image, text: `${s.engine} ${s.engine_tag}` });

    const kv = el("dl", { class: "kv" },
      el("dt", { text: "Port" }), el("dd", { class: "mono", text: String(s.port) }),
      el("dt", { text: "Base URL" }), el("dd", {}, el("span", { class: "inline" }, el("code", { text: s.base_url }), copyBtn(s.base_url))),
      el("dt", { text: "VRAM" }), el("dd", { text: s.gpu ? `${fmtGB(s.gpu.gb)} (${s.gpu.source === "util" ? "util " : ""}${s.gpu.fraction.toFixed(3)})` : "CPU" }),
      s.model ? el("dt", { text: "Model" }) : null, s.model ? el("dd", { class: "mono", text: s.model }) : null,
      el("dt", { text: "Image" }), el("dd", { class: "mono", text: s.image }),
    );

    let sig = null;
    if (s.signature) {
      const rows = [];
      for (const dir of ["inputs", "outputs"])
        for (const t of s.signature[dir])
          rows.push(el("tr", {}, el("td", { text: dir === "inputs" ? "in" : "out" }), el("td", { class: "mono", text: t.name }),
            el("td", { class: "mono", text: t.datatype }), el("td", { class: "mono", text: JSON.stringify(t.shape) })));
      sig = el("table", { class: "sig" },
        el("thead", {}, el("tr", {}, ...["", "tensor", "datatype", "shape"].map((h) => el("th", { text: h })))),
        el("tbody", {}, rows));
    }

    const reasons = [];
    if (s.contract_reason) reasons.push(el("p", { class: "reason" }, el("b", { text: "Contract: " }), s.contract_reason));
    if (s.custom_reason) reasons.push(el("details", {}, el("summary", { text: "Why custom?" }), el("p", { class: "reason", text: s.custom_reason })));

    const card = el("article", { class: "panel card" },
      el("div", { class: "card-top" }, dot, el("h2", { text: s.name }), s.alias ? el("span", { class: "alias mono", text: s.alias }) : null),
      el("div", { class: "badges" },
        el("span", { class: `badge ${s.kind}`, text: s.kind }),
        el("span", { class: `badge ${s.contract}`, text: s.contract }),
        el("span", { class: "badge", text: s.api }),
        engineBadge),
      s.description ? el("p", { class: "desc", text: s.description }) : null,
      el("div", { class: "tags", "aria-label": "Tasks" }, s.tasks.map((t) => {
        const b = el("button", { class: "tag", type: "button", title: `Show services trained for ${t}`, text: t });
        b.addEventListener("click", () => { const f = $("#f-task"); f.value = f.value === t ? "" : t; apply(); });
        return b;
      })),
      kv, sig, ...reasons,
      el("div", { class: "codebox" }, el("pre", {}, el("code", { text: s.usage })), copyBtn(s.usage)),
      el("div", { class: "inline" }, el("code", { text: s.snippet_cmd }), copyBtn(s.snippet_cmd)),
    );
    card._svc = s;
    cards.push(card);
  }
  const grid = $("#cards");
  const empty = el("div", { class: "empty", text: "No services match these filters." });
  grid.append(...cards, empty);

  function apply() {
    const q = $("#q").value.trim().toLowerCase();
    const want = Object.fromEntries(Object.entries(filters).map(([k, [sel]]) => [k, $(sel).value]));
    let shown = 0;
    for (const c of cards) {
      const s = c._svc;
      const hay = [s.name, s.alias, s.description, s.api, s.model, s.engine, s.contract, s.kind, ...s.tasks].filter(Boolean).join(" ").toLowerCase();
      const ok = (!q || hay.includes(q))
        && (!want.kind || s.kind === want.kind) && (!want.contract || s.contract === want.contract)
        && (!want.api || s.api === want.api) && (!want.engine || s.engine === want.engine)
        && (!want.task || s.tasks.includes(want.task));
      c.hidden = !ok;
      for (const b of c.querySelectorAll(".tag")) b.classList.toggle("on", b.textContent === want.task);
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    $("#count").textContent = `${shown} of ${cards.length} services`;
  }
  apply();

  // ---------------------------------------------------------------- live status
  async function ping(url) {
    const ctl = new AbortController();
    const t = setTimeout(() => ctl.abort(), 3000);
    try { await fetch(url, { mode: "no-cors", cache: "no-store", signal: ctl.signal }); return true; }
    catch { return false; }
    finally { clearTimeout(t); }
  }
  async function poll() {
    const results = await Promise.all(dots.map(([s]) => ping(s.health_url)));
    let up = 0;
    results.forEach((ok, i) => {
      const dot = dots[i][1];
      dot.className = "dot " + (ok ? "up" : "down");
      const label = ok ? "up (reachable)" : "down (unreachable)";
      dot.title = label; dot.setAttribute("aria-label", label);
      if (ok) up++;
    });
    $("#summary").textContent = `${DATA.services.length} services · ${up} up`;
  }
  $("#summary").textContent = `${DATA.services.length} services`;
  poll();
  setInterval(poll, 5000);
})();
</script>
</body>
</html>
